# ค่าที่ใช้ตอนรัน npm run dev เท่านั้น
# ไฟล์นี้ commit ขึ้น git ได้ ไม่มีความลับ — ห้ามใส่ API key ใดๆ
# เพราะค่าที่ขึ้นต้นด้วย VITE_ จะถูกฝังลงไฟล์ JS ที่ผู้ใช้เปิดดูได้

# ที่อยู่ของ backend ในเครื่องตัวเอง — ห้ามใส่ / ท้ายบรรทัด
VITE_API_URL=http://localhost:3000

# true  = ใช้เซิร์ฟเวอร์จำลองในเบราว์เซอร์ ไม่ต้องเปิด backend
# false = เรียก backend จริงตาม VITE_API_URL ข้างบน
VITE_USE_MOCK=false
