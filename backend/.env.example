# backend/.env.example
# คัดลอกไฟล์นี้เป็น backend/.env แล้วกรอกค่าจริง
# ห้าม commit ไฟล์ .env ขึ้น git (.gitignore กันไว้แล้ว)

# ------------------------------------------------------------
# ฐานข้อมูล
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appliance_repair

# ใบรับรอง TLS — เว้นว่างไว้ตอนใช้ MySQL ในเครื่อง
# ตอนใช้ฐานข้อมูลบนคลาวด์ ให้วางเนื้อหาไฟล์ ca.pem ลงตรงนี้
DB_SSL_CA=

# ------------------------------------------------------------
# เซิร์ฟเวอร์
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# บัญชีผู้ใช้ / JWT (migration 010)
# ------------------------------------------------------------
# กุญแจเซ็น JWT — บังคับ ยาวอย่างน้อย 32 ตัวอักษร ไม่งั้น backend บูตไม่ขึ้น
# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# อายุ token: จำนวน + หน่วย s/m/h/d/w/y เช่น 7d, 12h (ไม่ตั้ง = 7d) · ไม่มี refresh token
JWT_EXPIRES_IN=7d

# บัญชี admin คนแรก — ใช้เฉพาะตอนรัน npm run seed:admin (รันซ้ำได้ ไม่สร้างซ้ำ)
# รหัสผ่านยาว 8-72 ตัวอักษร · ถ้าอีเมลมีอยู่แล้วเป็น user จะถูกยกเป็น admin โดยไม่เปลี่ยนรหัสผ่าน
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

# ------------------------------------------------------------
# ร่างผังจาก PDF ด้วย LLM (ผู้ดูแลระบบ · Step 5 · migration 012)
# ------------------------------------------------------------
# ใช้ GROQ_API_KEY ตัวเดียวกับ rephrase (ด้านล่าง) แต่ต้องตั้งชื่อโมเดลของงานนี้เอง (ต้องรองรับ JSON mode)
# ไม่ตั้ง = อัปโหลดได้ แต่ร่างจะล้มด้วย LLM_NOT_CONFIGURED · REPHRASE_ENABLED ไม่เกี่ยวกับงานนี้
AUTHORING_LLM_MODEL=
# เวลารอ LLM ต่อการเรียก 1 ครั้ง (มิลลิวินาที) ค่าเริ่มต้น 60000
AUTHORING_LLM_TIMEOUT_MS=60000
# เพดาน token ของคำตอบต่อการเรียก ค่าเริ่มต้น 6000
AUTHORING_LLM_MAX_TOKENS=6000
# ขนาด PDF สูงสุด (MB) ค่าเริ่มต้น 10 · ไฟล์อยู่ในหน่วยความจำเท่านั้น ไม่เขียนดิสก์
AUTHORING_MAX_PDF_MB=10

# ------------------------------------------------------------
# ค้นหาอาการด้วยภาษาธรรมชาติ (โหลดโมเดล ใช้ RAM ราว 250-300 MB)
# ------------------------------------------------------------
# ต้องเป็น true เป๊ะๆ จึงโหลดโมเดล ค่าอื่นหรือเว้นว่าง = ปิด
SYMPTOM_SEARCH_ENABLED=false

# ------------------------------------------------------------
# LLM เรียบเรียงถ้อยคำของขั้นตอน (ทางเลือก ปิดเป็นค่าเริ่มต้น)
# ------------------------------------------------------------
# ต้องเป็น true เป๊ะๆ จึงเปิด ตั้งค่าไม่ครบ/เรียกไม่สำเร็จ/ไม่ผ่านด่านตรวจ = ใช้ข้อความต้นฉบับ
REPHRASE_ENABLED=false
GROQ_API_KEY=
# ชื่อโมเดลของ Groq (ไม่มีค่าเริ่มต้น เพราะชื่อโมเดลเปลี่ยนได้)
GROQ_MODEL=
# (ไม่บังคับ) ระดับการคิดของโมเดลที่คิดก่อนตอบ เช่น low — เว้นว่าง = ไม่ส่งพารามิเตอร์ (บางโมเดลไม่รองรับ จะได้ HTTP 400)
GROQ_REASONING_EFFORT=
# เวลารอ LLM สูงสุด (มิลลิวินาที) เกินแล้วใช้ข้อความต้นฉบับ
REPHRASE_TIMEOUT_MS=3000
