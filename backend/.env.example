# backend/.env.example
# คัดลอกไฟล์นี้เป็น backend/.env แล้วกรอกค่าจริง
# ห้าม commit ไฟล์ .env ขึ้น git (.gitignore กันไว้แล้ว)

# ------------------------------------------------------------
# ฐานข้อมูล
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appliance_repair

# ใบรับรอง TLS — เว้นว่างไว้ตอนใช้ MySQL ในเครื่อง
# ตอนใช้ฐานข้อมูลบนคลาวด์ ให้วางเนื้อหาไฟล์ ca.pem ลงตรงนี้
DB_SSL_CA=

# ------------------------------------------------------------
# เซิร์ฟเวอร์
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# ค้นหาอาการด้วยภาษาธรรมชาติ (โหลดโมเดล ใช้ RAM ราว 250-300 MB)
# ------------------------------------------------------------
# ต้องเป็น true เป๊ะๆ จึงโหลดโมเดล ค่าอื่นหรือเว้นว่าง = ปิด
SYMPTOM_SEARCH_ENABLED=false

# ------------------------------------------------------------
# LLM — ยังไม่ได้ใช้ (RAG เลื่อนเป็นงานอนาคต)
# ------------------------------------------------------------
GROQ_API_KEY=
