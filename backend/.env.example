# backend/.env.example
# คัดลอกไฟล์นี้เป็น backend/.env แล้วกรอกค่าจริง
# ห้าม commit ไฟล์ .env ขึ้น git (.gitignore กันไว้แล้ว)

# ------------------------------------------------------------
# ฐานข้อมูล
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appliance_repair

# ใบรับรอง TLS — เว้นว่างไว้ตอนใช้ MySQL ในเครื่อง
# ตอนใช้ฐานข้อมูลบนคลาวด์ ให้วางเนื้อหาไฟล์ ca.pem ลงตรงนี้
DB_SSL_CA=

# ------------------------------------------------------------
# เซิร์ฟเวอร์
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# ค้นหาอาการด้วยภาษาธรรมชาติ (โหลดโมเดล ใช้ RAM ราว 250-300 MB)
# ------------------------------------------------------------
# ต้องเป็น true เป๊ะๆ จึงโหลดโมเดล ค่าอื่นหรือเว้นว่าง = ปิด
SYMPTOM_SEARCH_ENABLED=false

# ------------------------------------------------------------
# LLM เรียบเรียงถ้อยคำของขั้นตอน (ทางเลือก ปิดเป็นค่าเริ่มต้น)
# ------------------------------------------------------------
# ต้องเป็น true เป๊ะๆ จึงเปิด ตั้งค่าไม่ครบ/เรียกไม่สำเร็จ/ไม่ผ่านด่านตรวจ = ใช้ข้อความต้นฉบับ
REPHRASE_ENABLED=false
GROQ_API_KEY=
# ชื่อโมเดลของ Groq (ไม่มีค่าเริ่มต้น เพราะชื่อโมเดลเปลี่ยนได้)
GROQ_MODEL=
# (ไม่บังคับ) ระดับการคิดของโมเดลที่คิดก่อนตอบ เช่น low — เว้นว่าง = ไม่ส่งพารามิเตอร์ (บางโมเดลไม่รองรับ จะได้ HTTP 400)
GROQ_REASONING_EFFORT=
# เวลารอ LLM สูงสุด (มิลลิวินาที) เกินแล้วใช้ข้อความต้นฉบับ
REPHRASE_TIMEOUT_MS=3000
