{
  "name": "appliance-repair-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Appliance repair assistant backend — Express + raw MySQL, traversal engine (state machine)",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "migrate": "node scripts/run-migrations.js",
    "seed": "node scripts/seed-graphs.js",
    "seed:equipment": "node scripts/seed-equipment.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.24.3",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
